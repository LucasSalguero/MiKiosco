generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPago {
  PAGADA
  A_COBRAR_HOY
  FIADA
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DESCONOCIDO
}

model Producto {
  id         Int         @id @default(autoincrement())
  nombre     String
  precio     Decimal     @db.Decimal(12, 2)
  activo     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  ventaItems VentaItem[]
}

model Venta {
  id              Int         @id @default(autoincrement())
  claveOperacion  String?     @unique
  fecha           DateTime    @default(now())
  total           Decimal     @db.Decimal(12, 2)
  estadoPago      EstadoPago  @default(PAGADA)
  clienteFiadoId  Int?
  clienteNombre   String?
  autorizadaPor   String?     @db.VarChar(120)
  sincronizada    Boolean     @default(true)
  anulada         Boolean     @default(false)
  items           VentaItem[]
  clienteFiado    Cliente?    @relation(fields: [clienteFiadoId], references: [id], onDelete: Restrict)
  pagos           Pago[]

  @@index([fecha])
  @@index([clienteFiadoId, estadoPago])
}

model VentaItem {
  id             Int       @id @default(autoincrement())
  ventaId        Int
  productoId     Int?
  productoNombre String
  cantidad       Int
  precioUnitario Decimal   @db.Decimal(12, 2)
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto? @relation(fields: [productoId], references: [id], onDelete: Restrict)
}

model Cliente {
  id               Int      @id @default(autoincrement())
  nombre           String
  nombreNormalizado String  @unique
  telefono         String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  ventas           Venta[]
  pagos            Pago[]
}

model Pago {
  id             Int        @id @default(autoincrement())
  clienteFiadoId Int
  ventaId        Int?
  monto          Decimal    @db.Decimal(12, 2)
  medio          MedioPago
  fecha          DateTime   @default(now())
  claveOperacion String     @unique
  anulado        Boolean    @default(false)
  clienteFiado   Cliente    @relation(fields: [clienteFiadoId], references: [id], onDelete: Restrict)
  venta          Venta?     @relation(fields: [ventaId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([clienteFiadoId, anulado])
  @@index([ventaId])
}

model AuthRateLimit {
  origen         String    @id @db.VarChar(64)
  intentos       Int       @default(0)
  ventanaInicia  DateTime
  bloqueadoHasta DateTime?
  expiraEn       DateTime

  @@index([expiraEn])
}
